{
  "name": "dwar",
  "version": "0.1.0",
  "description": "Browser game helper bot compiled to one JavaScript file.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "bundle": "rollup --config",
    "build": "npm run clean && npm run typecheck && npm run bundle",
    "test:minigame-matrices": "node --test tests/minigame-fragment-matrices.test.mjs",
    "test:minigame-recognizer": "node --test tests/minigame-fragment-recognizer.test.mjs tests/minigame-image-recognition.test.mjs",
    "test:exchange-monitoring": "node --test tests/exchange-monitoring-domain.test.mjs",
    "test:hunting": "node --test tests/hunt-mob-attack-selection.test.mjs",
    "test:mining": "node --test tests/hunt-resource-canvas-filter.test.mjs",
    "minigame:matrices": "node scripts/minigame-fragment-matrices.mjs",
    "minigame:recognize": "node scripts/minigame-fragment-recognizer.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@swc/core": "^1.7.0",
    "@types/node": "^22.0.0",
    "pngjs": "^7.0.0",
    "rollup": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  }
}
